# ------------------------------------------------------------------
#  GuardAI — environment
#  Copy to .env.local and fill in. Never commit .env.local.
# ------------------------------------------------------------------

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — used for audit writes and the Super Admin console.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute origin used to build OAuth and email redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis — rate limiting, brute-force lockout, OTP throttling.
# Optional in development (falls back to an in-process counter).
# Required in production: lib/redis.ts throws without it.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ------------------------------------------------------------------
#  Phase 2 — ingestion, embeddings, and RAG
# ------------------------------------------------------------------

# OpenAI. Powers text-embedding-3-small (1536-dim vectors) and the
# structured threat analysis pass.
OPENAI_API_KEY=sk-your-openai-key

# Upstash QStash — the durable background queue for log processing.
# Optional in development: the app falls back to Next's `after()`, which
# is still off the response path but is not retried or durable.
# Required in production.
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=sig_your-current-key
QSTASH_NEXT_SIGNING_KEY=sig_your-next-key

# ------------------------------------------------------------------
#  Phase 4 — Stripe billing (test / sandbox mode)
# ------------------------------------------------------------------

# Secret key from https://dashboard.stripe.com/test/apikeys
# A test-mode key starts with sk_test_. Never commit a live key.
STRIPE_SECRET_KEY=sk_test_your-secret-key

# Endpoint signing secret. Printed by `stripe listen` when forwarding
# locally, or shown once when you create the endpoint in the dashboard.
# Every webhook payload is verified against this before it is read, so a
# wrong value means all billing events are rejected.
STRIPE_WEBHOOK_SECRET=whsec_your-signing-secret

# The recurring Price the Pro plan checks out against ($20/month).
# Create the Product + Price in the dashboard, then copy the price id.
STRIPE_PRO_PRICE_ID=price_your-pro-price-id

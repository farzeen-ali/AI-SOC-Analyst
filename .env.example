# ------------------------------------------------------------------
#  GuardAI — environment
#  Copy to .env.local and fill in. Never commit .env.local.
# ------------------------------------------------------------------

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — used for audit writes and the Super Admin console.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute origin used to build OAuth and email redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis — rate limiting, brute-force lockout, OTP throttling.
# Optional in development (falls back to an in-process counter).
# Required in production: lib/redis.ts throws without it.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
